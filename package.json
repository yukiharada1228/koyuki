{
  "name": "koyuki",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/*.test.tsx",
    "compare": "node scripts/compare.mjs",
    "test:comparison": "tsx --test src/comparison.test.tsx",
    "demo": "tsx src/comparison/demo.ts",
    "test:approval": "tsx --test src/approval.test.tsx",
    "demo:approval": "tsx src/approval/demo.ts",
    "test:tags": "tsx --test src/tags.test.tsx",
    "demo:tags": "tsx src/tags/demo.ts",
    "compare:tags": "node scripts/compare-tags.mjs",
    "dev": "npm run build:view && tsx src/web/server.ts",
    "test:web": "tsx --test src/web.test.ts",
    "test:lifecycle": "tsx --test src/lifecycle.test.tsx",
    "test:shipping": "tsx --test src/shipping.test.ts",
    "demo:shipping": "tsx src/shipping/demo.ts",
    "demo:events": "tsx src/examples/tag-events.ts",
    "test:model": "tsx --test src/model.test.ts src/command.test.ts",
    "demo:program": "tsx src/examples/tag-program.ts",
    "test:program": "tsx --test src/program.test.ts",
    "build:view": "node scripts/build-view.mjs",
    "pretest": "npm run build:view",
    "demo:expenses": "tsx src/expenses/demo.ts",
    "test:expenses": "tsx --test src/expenses.test.ts",
    "demo:expenses:sqlite": "tsx src/expenses/sqlite-demo.ts",
    "test:expenses:sqlite": "tsx --test src/expenses-sqlite.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:inventory": "npm --prefix examples/inventory run check",
    "test:inventory": "npm --prefix examples/inventory test",
    "demo:inventory": "npm --prefix examples/inventory start",
    "test:replay": "tsx --test src/replay.test.ts src/replay-detail.test.ts src/expense-replay.test.ts",
    "demo:expenses:replay": "tsx src/examples/expense-replay.ts",
    "test:inventory:package": "node scripts/test-inventory-package.mjs",
    "demo:expenses:correction": "tsx src/examples/expense-correction.ts",
    "test:quickstart": "node scripts/test-quickstart.mjs",
    "test:quickstart:registry": "node scripts/test-quickstart.mjs --registry",
    "check:leave": "npm --prefix examples/leave run check",
    "test:leave": "npm --prefix examples/leave test",
    "demo:leave": "npm --prefix examples/leave start",
    "test:leave:package": "node scripts/test-leave-package.mjs",
    "test:leave:development": "node scripts/test-leave-package.mjs --development",
    "test:use-case:package": "node scripts/test-leave-package.mjs --declarative",
    "test:portable": "npm run build && node scripts/test-portable.mjs",
    "check:package": "npm run build && node scripts/check-runtime-package.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "latest",
    "typescript": "latest",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "version": "0.1.0-alpha.4",
  "description": "Declarative, functional business workflows for TypeScript",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiharada1228/koyuki.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "license": "MIT",
  "homepage": "https://github.com/yukiharada1228/koyuki#readme",
  "bugs": {
    "url": "https://github.com/yukiharada1228/koyuki/issues"
  }
}
