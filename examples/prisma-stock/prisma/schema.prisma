generator client {
  provider = "prisma-client"
  output   = "../.generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model Stock {
  id      String @id
  units   Int
  version Int
}
model Movement {
  id            String @id
  source        String
  target        String
  units         Int
  sourceVersion Int
  targetVersion Int
}
